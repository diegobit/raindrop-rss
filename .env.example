# Copy to .env so the container runs as the user who owns the mounted files:
#   printf 'RSS_UID=%s\nRSS_GID=%s\n' "$(id -u)" "$(id -g)" > .env
RSS_UID=1000
RSS_GID=1000
# RSS_PORT=38471

# On the Geekom, uncomment both to publish the page through Cloudflare.
# The token is the one Cloudflare shows when you create the tunnel.
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
